# Biome Platform — environment
# Copy to .env.local. Never commit the real file.

# --- AI (existing) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Google Drive cloud storage ---
# See CLOUD-SETUP.md. These stay on the server and are never sent to a
# browser. The app starts perfectly well without them — cloud storage just
# reports "not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/cloud/callback

# --- Session signing ---
# Electron generates this per installation. Set it by hand only when
# running `next dev` outside Electron.
BIOME_AUTH_SECRET=
